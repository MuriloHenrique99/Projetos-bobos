#include <iostream>
#include <vector>
using namespace std;

std::vector<int> filterNumbers(vector<int>* numeros, int minimo){
    std::vector<int> filtrado;
    int filtros = 0;
    for(int i = 0; i < (*numeros).size(); ++i){
        if((*numeros)[i] > minimo){
            filtrado.push_back((*numeros)[i]);
            filtros += 1;
        }
    }
    std::cout << "Filtered count: " << filtros << std::endl;
    return filtrado;
}

int main() {
    int n;
    cin >> n;
    

    vector<int> numbers;
    for (int i = 0; i < n; i++) {
        int num;
        cin >> num;
        numbers.push_back(num);
    }
    
    int threshold;
    cin >> threshold;
    

    vector<int> filtros = filterNumbers(&numbers, threshold);

    for(int i = 0; i < filtros.size(); ++i){
        std::cout << filtros[i] << std::endl;
    }
    return 0;
}
